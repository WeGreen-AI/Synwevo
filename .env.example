# Copy to .env (or export) – all values optional.
DOCWEAVE_HOST=127.0.0.1            # 0.0.0.0 to listen on all interfaces (put a reverse proxy with auth in front)
DOCWEAVE_PORT=8765
DOCWEAVE_DATA_DIR=./data           # SQLite database + content-addressed file storage
# DOCWEAVE_UI_DIR=./frontend/dist  # built web UI
# DOCWEAVE_SOFFICE=/usr/bin/soffice     # LibreOffice binary (auto-detected)
# DOCWEAVE_TESSERACT=/usr/bin/tesseract # Tesseract binary (auto-detected)
# DOCWEAVE_TESSDATA=./backend/tessdata  # chi_sim/eng traineddata directory
# DOCWEAVE_LO_PROFILE=/tmp/docweave-lo  # private LibreOffice profile (default: per process in $TMPDIR)
# Limits
DOCWEAVE_MAX_FILE_MB=100
DOCWEAVE_MAX_UNZIPPED_MB=600
DOCWEAVE_MAX_ZIP_ENTRIES=20000
DOCWEAVE_MAX_CELLS=2000000
DOCWEAVE_MAX_PAGES=2000
DOCWEAVE_MAX_IMAGE_MPIX=80
DOCWEAVE_MAX_RECORDS_PER_JOB=20000
DOCWEAVE_CONVERTER_TIMEOUT=180
DOCWEAVE_OCR_TIMEOUT=120
