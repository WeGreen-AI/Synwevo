# Synwevo 配置示例：复制为 .env 或直接以环境变量导出。所有项都可省略，默认值见注释。
# 容器（infra/docker-compose.yml）会读取仓库根目录的 .env（可选）；监听地址与数据目录描述的是
# 容器自身，由 compose 固定为 0.0.0.0 与 /data，这里写什么都不会覆盖它们。
# 旧的 DOCWEAVE_* 名字**仍然被接受**（见 docs/migrations/synwevo-rebrand.md §4）：只设旧名字
# 会提示一次；新旧都设且值不同时，涉及数据、密钥或信任边界的项会直接拒绝启动而不是替你猜。
# 角色划分与目录结构见 docs/architecture/monorepo.md。
# 端口与监听详见 docs/integration/ports.md，接口见 docs/integration/api.md。

# ---------------------------------------------------------------- 角色
# SYNWEVO_ROLE=all                # all（单进程：工作台 + 账户页）/ accounts / portal / app
#                                  一个进程一个角色；路由按角色挂载，网关按角色拒绝。

# ---------------------------------------------------------------- 服务与界面
# SYNWEVO_HOST=127.0.0.1          # 默认仅本机；对外请用反向代理，并设置下面的 SYNWEVO_UI_AUTH
# SYNWEVO_PORT=8765
# SYNWEVO_DATA_DIR=/srv/synwevo/data
                                   # SQLite 数据库 + 内容寻址文件存储 + 安全日志（请整体纳入备份）
                                   # 不设时取仓库根目录的 data/，解析不依赖进程 cwd；
                                   # 在源码检出之外则报错而不是猜（空库看起来像数据没了）。
                                   # 请写绝对路径：相对路径会按启动进程的当前目录解析。
# SYNWEVO_DOCS_UI_DIR=./apps/docs/web/dist                    # Synwevo Docs 工作台外壳
# SYNWEVO_ACCOUNTS_UI_DIR=./services/identity/web/dist        # Synwevo Account 外壳
# SYNWEVO_PORTAL_UI_DIR=./apps/portal/web/dist                # Synwevo Workspace 外壳
# 三个外壳的静态资源目录分别是 assets / account-assets / portal-assets，
# 不同名是有意的：单进程部署同时提供其中两个，同名会互相遮盖。
SYNWEVO_UI_AUTH=none              # none（仅限本机监听）/ basic（python -m synwevo_identity.cli ui-user add）
                                   # / proxy（由反向代理认证）/ session（平台统一账户）
# SYNWEVO_UI_TENANT=default       # 界面数据归属的租户；与之相同租户的 API 密钥可复用界面里做好的模板

# ---------------------------------------------------------------- 机器接口
# 密钥用 CLI 创建，不写在这里：python -m synwevo_docs.cli apikey create --name ci --scopes read,write
SYNWEVO_API_RATE_PER_MIN=300      # 每个密钥每分钟请求上限（按进程计）
SYNWEVO_API_DOCS=0                # 1 = 开放 /api/docs 交互式文档（仅建议开发环境）
SYNWEVO_DOCS_DOWNLOAD_LINK_TTL_S=900   # 签名下载链接有效期
SYNWEVO_DOCS_IDEMPOTENCY_TTL_HOURS=24  # 幂等键保留期
# SYNWEVO_DOCS_IMPORT_ROOTS=/srv/incoming   # 允许按服务器路径读取来源文件的根目录（默认关闭，只接受上传）
# SYNWEVO_SECRET=                 # 服务端根密钥：签名下载链接，并派生两步验证种子与 Webhook 签名密钥的加密密钥。
                                   # 不设置时自动生成并保存在数据库（与密文同库，拿到库即可解密）。
                                   # 一经使用不能直接更换：先运行 python -m synwevo_identity.cli secret rekey
# SYNWEVO_DOCS_RESOURCE=urn:synwevo:app:docweave   # 本应用的令牌受众（RFC 8707 resource）
# SYNWEVO_DOCS_REQUIRE_AUDIENCE=0     # 1 = 拒绝未带受众的访问令牌（默认接受旧令牌）
# SYNWEVO_DOCS_MAX_ACTIVE_JOBS=10     # 每个工作空间同时排队/运行的任务上限（超过返回 429）

# ---------------------------------------------------------------- 任务
SYNWEVO_DOCS_JOB_LEASE_S=30            # 任务租约；工作进程消失后超过租约即自动恢复
SYNWEVO_DOCS_MAX_RECORDS_PER_JOB=20000

# ---------------------------------------------------------------- Webhook（默认关闭）
# SYNWEVO_DOCS_WEBHOOK_URLS=https://automation.example.com/hooks/synwevo
# SYNWEVO_DOCS_WEBHOOK_SECRET=<共享密钥：用于 HMAC-SHA256 签名>
# SYNWEVO_DOCS_WEBHOOK_EVENTS=job.completed,job.completed_with_errors,job.failed,job.cancelled
# SYNWEVO_DOCS_WEBHOOK_ALLOW_PRIVATE=   # 仅在确需回调内网时填写：10.0.0.0/8,automation.internal
# SYNWEVO_DOCS_WEBHOOK_ALLOW_HTTP=0     # 1 = 允许 http 回调（默认要求 https）
# SYNWEVO_DOCS_WEBHOOK_TIMEOUT_S=10

# ---------------------------------------------------------------- 外部工具与引擎
# SYNWEVO_DOCS_SOFFICE=/usr/bin/soffice      # LibreOffice（自动探测）
# SYNWEVO_DOCS_TESSERACT=/usr/bin/tesseract  # Tesseract（自动探测）
# SYNWEVO_DOCS_TESSDATA=/srv/synwevo/tessdata  # chi_sim / eng 语言模型目录（默认 apps/docs/tessdata）
# SYNWEVO_DOCS_CJK_FONTS=/System/Library/Fonts/STHeiti Light.ttc   # 提供给 LibreOffice 的中文字体（自动探测）
# SYNWEVO_DOCS_LO_PROFILE=/tmp/synwevo-lo   # LibreOffice 配置目录的父目录；实际使用 <父目录>/profile-<PID>，始终按进程隔离
# SYNWEVO_DOCS_PDF_ENGINE=pymupdf            # pymupdf（默认，AGPL/商业许可）或 pdfium（Apache/BSD，无 PDF/图片模板）
# SYNWEVO_DOCS_SOURCE_OFFER=on               # 使用 PyMuPDF 时在「关于与许可」提供源代码下载（AGPL 第 13 条）
# SYNWEVO_DOCS_REGRESSION_DIR=/srv/synwevo/regression   # 回归用例目录

# ---------------------------------------------------------------- 限制
SYNWEVO_DOCS_MAX_FILE_MB=100
SYNWEVO_DOCS_MAX_UNZIPPED_MB=600
SYNWEVO_DOCS_MAX_ZIP_ENTRIES=20000
SYNWEVO_DOCS_MAX_CELLS=2000000
SYNWEVO_DOCS_MAX_PAGES=2000
SYNWEVO_DOCS_MAX_IMAGE_MPIX=80
SYNWEVO_DOCS_CONVERTER_TIMEOUT=180
SYNWEVO_DOCS_OCR_TIMEOUT=120

# ---------------------------------------------------------------- 统一账户与单点登录（平台级）
# 本机三源站运行（python scripts/platform.py up）会替每个服务设置这些值；拆分或生产部署必须自己设置，
# 否则会退回到只适用于本机的默认值（accounts.localhost / docweave.localhost）。
# SYNWEVO_ISSUER=https://accounts.example.com      # 账户服务的对外地址（OIDC 发行者）；默认 http://accounts.localhost:8770
# SYNWEVO_APP_URL=https://docs.example.com         # 本进程作为依赖方时的对外地址；默认 http://docweave.localhost:8765
# SYNWEVO_PUBLIC_URL=https://docs.example.com      # 邮件与机器接口里生成绝对链接用的地址
# SYNWEVO_PORTAL_URL=https://portal.example.com    # 账户页「返回」链接指向的门户
# SYNWEVO_OIDC_CLIENT_ID=docweave-web              # 本进程登记的 OIDC 客户端（python -m synwevo_identity.cli client register）
# SYNWEVO_OIDC_APP_ID=docweave                     # 应用注册表里的 app_id
# SYNWEVO_OIDC_PROXY=                              # 服务端到账户服务的出站代理（可选）
# SYNWEVO_COOKIE_SECURE=1                          # 默认开启；仅本机 http 开发时设为 0
# SYNWEVO_TRUST_PROXY=0                            # 1 = 信任反向代理的 X-Forwarded-For（只在确有代理时开启）
# SYNWEVO_RP_ID=example.com                        # Passkey 绑定的域；默认取发行者的主机名，改动后已注册的 Passkey 需重新注册
# SYNWEVO_RP_ORIGINS=https://docs.example.com      # 额外允许发起 Passkey 仪式的源（逗号分隔，精确匹配）
# SYNWEVO_REGISTRATION=invite                      # invite（默认）/ open / closed
# SYNWEVO_PLATFORM_NAME=Synwevo                    # 界面与 Passkey 里显示的平台名
# SYNWEVO_SESSION_IDLE_S=43200                     # 会话空闲超时（秒）
# SYNWEVO_SESSION_ABSOLUTE_S=2592000               # 会话绝对超时（秒）
# SYNWEVO_ADMIN_IDLE_S=3600                        # 平台管理会话空闲超时（秒）
# SYNWEVO_REAUTH_S=600                             # 敏感操作要求的「最近一次验证」时长（秒）
# SYNWEVO_ACCESS_TTL_S=900                         # 访问令牌有效期（秒）
# SYNWEVO_REFRESH_TTL_S=1209600                    # 刷新令牌有效期（秒）

# ---------------------------------------------------------------- 邮件（邀请、找回口令）
# SYNWEVO_MAIL_MODE=                    # smtp / file / disabled；不设时有 SMTP_HOST 即 smtp，否则 disabled
# SYNWEVO_MAIL_FROM=synwevo@localhost
# SYNWEVO_MAIL_FROM_NAME=Synwevo
# SYNWEVO_MAIL_DIR=/srv/synwevo/mail    # file 模式的投递目录（请写绝对路径）
# SYNWEVO_SMTP_HOST=smtp.example.com
# SYNWEVO_SMTP_PORT=587
# SYNWEVO_SMTP_USER=
# SYNWEVO_SMTP_PASSWORD=                # 不要提交真实值
# SYNWEVO_SMTP_STARTTLS=1
# SYNWEVO_SMTP_SSL=0
# SYNWEVO_SMTP_TIMEOUT_S=20
