# 平台配置示例：复制为 .env 或直接以环境变量导出。所有项都可省略，默认值见注释。
# 角色划分与目录结构见 docs/architecture/monorepo.md。
# 端口与监听详见 docs/integration/ports.md，接口见 docs/integration/api.md。

# ---------------------------------------------------------------- 角色
# DOCWEAVE_ROLE=all                # all（单进程：工作台 + 账户页）/ accounts / portal / app
#                                  一个进程一个角色；路由按角色挂载，网关按角色拒绝。

# ---------------------------------------------------------------- 服务与界面
DOCWEAVE_HOST=127.0.0.1            # 默认仅本机；对外请用反向代理，并设置下面的 DOCWEAVE_UI_AUTH
DOCWEAVE_PORT=8765
DOCWEAVE_DATA_DIR=./data           # SQLite 数据库 + 内容寻址文件存储（请纳入备份）
                                   # 不设时取仓库根目录的 data/；解析不依赖进程 cwd，
                                   # 在源码检出之外则报错而不是猜（空库看起来像数据没了）
# DOCWEAVE_UI_DIR=./apps/docweave/web/dist          # DocWeave 工作台外壳
# PLATFORM_ACCOUNTS_UI_DIR=./services/identity/web/dist   # 账户与安全外壳
# PLATFORM_PORTAL_UI_DIR=./apps/portal/web/dist           # 门户外壳
# 三个外壳的静态资源目录分别是 assets / account-assets / portal-assets，
# 不同名是有意的：单进程部署同时提供其中两个，同名会互相遮盖。
DOCWEAVE_UI_AUTH=none              # none（仅限本机监听）/ basic（python -m platform_identity.cli ui-user add）
                                   # / proxy（由反向代理认证）/ session（平台统一账户）
# DOCWEAVE_UI_TENANT=default       # 界面数据归属的租户；与之相同租户的 API 密钥可复用界面里做好的模板

# ---------------------------------------------------------------- 机器接口
# 密钥用 CLI 创建，不写在这里：python -m docweave.cli apikey create --name ci --scopes read,write
DOCWEAVE_API_RATE_PER_MIN=300      # 每个密钥每分钟请求上限（按进程计）
DOCWEAVE_API_DOCS=0                # 1 = 开放 /api/docs 交互式文档（仅建议开发环境）
DOCWEAVE_DOWNLOAD_LINK_TTL_S=900   # 签名下载链接有效期
DOCWEAVE_IDEMPOTENCY_TTL_HOURS=24  # 幂等键保留期
# DOCWEAVE_IMPORT_ROOTS=/srv/incoming   # 允许按服务器路径读取来源文件的根目录（默认关闭，只接受上传）
# DOCWEAVE_SECRET=                 # 签名下载链接用的服务端密钥；不设置时自动生成并保存在数据库

# ---------------------------------------------------------------- 任务
DOCWEAVE_JOB_LEASE_S=30            # 任务租约；工作进程消失后超过租约即自动恢复
DOCWEAVE_MAX_RECORDS_PER_JOB=20000

# ---------------------------------------------------------------- Webhook（默认关闭）
# DOCWEAVE_WEBHOOK_URLS=https://automation.example.com/hooks/docweave
# DOCWEAVE_WEBHOOK_SECRET=<共享密钥：用于 HMAC-SHA256 签名>
# DOCWEAVE_WEBHOOK_EVENTS=job.completed,job.completed_with_errors,job.failed,job.cancelled
# DOCWEAVE_WEBHOOK_ALLOW_PRIVATE=   # 仅在确需回调内网时填写：10.0.0.0/8,automation.internal
# DOCWEAVE_WEBHOOK_ALLOW_HTTP=0     # 1 = 允许 http 回调（默认要求 https）
# DOCWEAVE_WEBHOOK_TIMEOUT_S=10

# ---------------------------------------------------------------- 外部工具与引擎
# DOCWEAVE_SOFFICE=/usr/bin/soffice      # LibreOffice（自动探测）
# DOCWEAVE_TESSERACT=/usr/bin/tesseract  # Tesseract（自动探测）
# DOCWEAVE_TESSDATA=./backend/tessdata   # chi_sim / eng 语言模型目录
# DOCWEAVE_CJK_FONTS=/System/Library/Fonts/STHeiti Light.ttc   # 提供给 LibreOffice 的中文字体（自动探测）
# DOCWEAVE_LO_PROFILE=/tmp/docweave-lo   # LibreOffice 配置目录的父目录；实际使用 <父目录>/profile-<PID>，始终按进程隔离
# DOCWEAVE_PDF_ENGINE=pymupdf            # pymupdf（默认，AGPL/商业许可）或 pdfium（Apache/BSD，无 PDF/图片模板）
# DOCWEAVE_SOURCE_OFFER=on               # 使用 PyMuPDF 时在「关于与许可」提供源代码下载（AGPL 第 13 条）
# DOCWEAVE_REGRESSION_DIR=./regression   # 回归用例目录

# ---------------------------------------------------------------- 限制
DOCWEAVE_MAX_FILE_MB=100
DOCWEAVE_MAX_UNZIPPED_MB=600
DOCWEAVE_MAX_ZIP_ENTRIES=20000
DOCWEAVE_MAX_CELLS=2000000
DOCWEAVE_MAX_PAGES=2000
DOCWEAVE_MAX_IMAGE_MPIX=80
DOCWEAVE_CONVERTER_TIMEOUT=180
DOCWEAVE_OCR_TIMEOUT=120
