# Copy only to a private file outside Git. Docker Compose reads it with format: raw.
# Values are literal: no shell expansion, no quotes around the password.
SYNWEVO_MAIL_MODE=smtp
SYNWEVO_MAIL_FROM=mail@hikosphere.com
SYNWEVO_MAIL_FROM_NAME=Synwevo
SYNWEVO_SMTP_HOST=mail.hikosphere.com
SYNWEVO_SMTP_PORT=587
SYNWEVO_SMTP_USER=mail@hikosphere.com
SYNWEVO_SMTP_PASSWORD=REPLACE_WITH_MAILBOX_PASSWORD
SYNWEVO_SMTP_STARTTLS=1
SYNWEVO_SMTP_SSL=0
SYNWEVO_SMTP_TIMEOUT_S=15
