# Test the actual runtime image, with no production data mounted. Never deploy this image.
ARG RUNTIME_IMAGE=synwevo:ci
FROM ${RUNTIME_IMAGE}
USER root
RUN apt-get update && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir -r requirements-dev.txt && pip check
# The event-catalogue integration test imports the real external SDK. Installing it on
# the Actions host does not install it inside this independent test image.
RUN pip install --no-cache-dir --no-deps --no-build-isolation apps/docs/sdk/python && pip check
COPY infra/production infra/production
# Match repository test isolation and shared fixtures; runtime configuration is scrubbed before collection.
COPY conftest.py ./conftest.py
# Synthetic document fixtures are generated beneath /app/testdata during the test session.
RUN chown -R synwevo:synwevo /app
USER synwevo
HEALTHCHECK NONE
CMD ["python", "-m", "pytest", "--tb=short"]
