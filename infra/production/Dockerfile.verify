# Test the actual runtime image, with no production data mounted. Never deploy this image.
ARG RUNTIME_IMAGE=synwevo:ci
FROM ${RUNTIME_IMAGE}
USER root
RUN apt-get update && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*
# The catalogue tests import the external SDK from this same source checkout, like the
# runtime modules. The separate CI SDK step still tests a regular non-editable installation.
RUN pip install --no-cache-dir -r requirements-dev.txt \
    && pip install --no-cache-dir --no-deps --no-build-isolation -e apps/docs/sdk/python \
    && pip check
COPY infra/production infra/production
# Match repository test isolation and shared fixtures; runtime configuration is scrubbed before collection.
COPY conftest.py ./conftest.py
# Synthetic document fixtures are generated beneath /app/testdata during the test session (the root
# conftest's `fixtures`, in whichever container asks: testdata/ is git-ignored, so the archive has none).
RUN chown -R synwevo:synwevo /app \
    && install -d -o synwevo -g synwevo /tmp/ci-test-artifacts
USER synwevo
HEALTHCHECK NONE
# Only this disposable verification image removes passing tests' owned temporary directories.
# Keep all phases' failures; root conftest waits until worker/resource teardown has completed.
ENV CI=true
# A failed gate must print its first traceback before the outer job timeout.
# Successful runs still execute the complete configured suite; timings and skip
# reasons make capacity and unavailable integration dependencies reviewable.
CMD ["python", "-m", "pytest", "--tb=short", "--maxfail=1", "--durations=20", "-ra", "--ci-clean-passed-tmp", "--basetemp=/tmp/ci-test-artifacts/pytest"]
