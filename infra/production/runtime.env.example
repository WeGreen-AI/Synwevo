# Install as /opt/synwevo/config/runtime.env, root:root 0600. Do not commit real values.
# Existing root/signing keys remain in the migrated database; do not set a replacement secret.
SYNWEVO_MAIL_MODE=disabled
SYNWEVO_DOCS_PDF_ENGINE=pymupdf
# Live table editing (read by Docs only): off | on | workspace ids (a trial). Set here, never in
# compose.yaml (an installed compose.yaml would end a trial silently; its `environment` would override
# this file). Start and end it as docs/operations.md §10 says, e.g.:
# SYNWEVO_SHEET_LIVE=<workspace id>

# Business applications stay unavailable until their release acceptance is complete.
# Enable only verified application ids, comma separated; see docs/agent-runtime.md.
# SYNWEVO_SUITE_APPS=forms
# Agent requires an explicit provider model AND a server or encrypted personal key.
# SYNWEVO_AGENT_MODEL=<verified provider model id>
# SYNWEVO_AGENT_ANTHROPIC_API_KEY=<server-side provider key>

# Model price governance only; this does not enable paid calls or payment collection.
# Choose the environment explicitly. Unset/invalid keeps price mutations closed.
# SYNWEVO_BILLING_ENVIRONMENT=test
# Read-only personal wallet; explicitly supply approved, already registered unit definitions.
# SYNWEVO_BILLING_WALLET_UNITS=[]
