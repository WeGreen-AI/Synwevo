{
  "name": "synwevo",
  "private": true,
  "version": "1.0.0",
  "description": "Synwevo 平台单仓库：Synwevo Workspace、Synwevo Account、Synwevo Docs 与共享前端包",
  "workspaces": [
    "packages/ui",
    "packages/auth-client/web",
    "apps/docs/web",
    "apps/portal/web",
    "services/identity/web"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build:docs": "npm run build -w @synwevo/docs-web",
    "build:workspace": "npm run build -w @synwevo/workspace-web",
    "build:account": "npm run build -w @synwevo/account-web"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WeGreen-AI/Synwevo.git"
  }
}
