    {
      "id": "verify-checksums",
      "name": "Verify checksums",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        8580,
        0
      ],
      "parameters": {
        "jsCode": "const items = $input.all(); const artifacts = $('Artifact items').all();\nfor (let i = 0; i < items.length; i++) {\n  const bytes = await this.helpers.getBinaryDataBuffer(i, 'data');\n  const digest = require('crypto').createHash('sha256').update(bytes).digest('hex');\n  const a = artifacts[i].json; const header = items[i].json.headers['x-content-sha256'];\n  if (digest !== a.sha256 || digest !== header) throw new Error('Checksum mismatch');\n  if (/[\\/\\\\]/.test(a.filename) || a.filename === '..') throw new Error('Unsafe artifact filename');\n  items[i].json = { ...a, manifest_sha256: a.sha256, header_sha256: header,\n    path: $('Config').first().json.outDir + '/' + a.filename };\n}\nreturn items;"
      }
    },
