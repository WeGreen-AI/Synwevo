      ],
      "parameters": {
        "jsCode": "return [{ json: { project_id: $('Create project').first().json.id, template_id: $('Upload template').first().json.id, job: $('Check job').first().json,\n  preflight: $('Preflight').first().json, preview: { ...$('Preview render').first().json, download: $('Verify preview').first().json },\n  artifacts: $('Verify checksums').all().map(i => i.json) } }];"
      }
    }
