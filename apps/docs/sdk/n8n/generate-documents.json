    {
      "id": "artifact-items",
      "name": "Artifact items",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        8140,
        0
      ],
      "parameters": {
        "jsCode": "const pages = $input.all();\nif (pages.at(-1).json.next_cursor) throw new Error('Manifest page limit exceeded');\nconst artifacts = pages.flatMap(i => i.json.items);\nif (artifacts.length !== 12 || new Set(artifacts.map(a => a.id)).size !== 12) throw new Error('Incomplete synthetic manifest');\nreturn artifacts.map(a => ({ json: a }));"
      }
    },
    {
      "id": "download-artifacts",
      "name": "Download artifacts",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        8360,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $('Config').first().json.baseUrl + '/api/v1/artifacts/' + $json.id + '/content' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "oAuth2Api",
        "options": {
          "timeout": 30000,
          "redirect": {
            "redirect": {
              "followRedirects": false
            }
          },
          "response": {
