        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { id: $('Verify raw body').first().json.id, lease: $('Verify raw body').first().json.lease } }}"
      }
    },
    {
      "id": "retry-later",
      "name": "Retry later",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [
        4180,
        0
      ],
      "parameters": {
        "respondWith": "noData",
        "options": {
          "responseCode": 503
        }
      }
    }
