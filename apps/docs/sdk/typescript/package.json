{
  "name": "@synwevo/docs-sdk",
  "version": "0.1.0",
  "private": true,
  "description": "Synwevo Docs machine-API client for Node.js: one dependency-free ES module with TypeScript declarations.",
  "type": "module",
  "main": "./synwevo-docs.mjs",
  "types": "./synwevo-docs.d.ts",
  "exports": {
    ".": {
      "types": "./synwevo-docs.d.ts",
      "default": "./synwevo-docs.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "synwevo-docs.mjs",
    "synwevo-docs.d.ts",
    "synwevo-docs.d.mts",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  }
}
